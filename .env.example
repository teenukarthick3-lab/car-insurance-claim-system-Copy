# Google Gemini API settings
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Photo validation settings
PHOTO_VALIDATION_MODE=auto
PHOTO_CONFIDENCE_THRESHOLD=0.80

